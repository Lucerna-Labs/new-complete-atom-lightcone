{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightcone.local/schemas/coverage-ledger.schema.json",
  "title": "Open-ended exhaustive coverage ledger",
  "type": "object",
  "required": ["schema_version", "open_world", "catalog_hashes", "items"],
  "properties": {
    "schema_version": { "const": 1 },
    "open_world": { "const": true },
    "catalog_hashes": {
      "type": "object",
      "required": ["domain_catalog", "lane_catalog", "coverage_axes"],
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "mandatory", "status", "coverage"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "kind": { "enum": ["lane", "domain", "subfield", "bridge"] },
          "parent": { "type": ["string", "null"] },
          "mandatory": { "type": "boolean" },
          "status": { "enum": ["discovered", "scoped", "sourced", "authored", "compiled", "trained", "locally_validated", "accelerator_validated", "sealed", "blocked", "retired"] },
          "coverage": {
            "type": "object",
            "additionalProperties": { "enum": ["missing", "planned", "authored", "tested", "sealed", "inapplicable"] }
          },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

